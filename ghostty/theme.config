font-family		= "JetBrainsMono Nerd Font"
font-size		= 16
font-feature	= ["calt", "liga"]

theme = Kanagawa Dragon

background-image = ~/wallpapers/1.png

# Görselin opaklığı (0.0 ile 1.0 arası; metinlerin okunabilmesi için düşük tutulması önerilir)
background-image-opacity = 0.15

# contain, cover, stretch, none
background-image-fit = cover
